<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    tools:context=".CreateProduct">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Crear Producto"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <LinearLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Nombre"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/txtbx_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el nombre"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Imagen"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/txtbx_img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el link de la imágen"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Descripción"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/txtbx_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese la descripción"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Precio"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/txtbx_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el precio"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="SKU"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/txtbx_sku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ingrese el SKU"/>

    </LinearLayout>

    <Button
        android:id="@+id/create_product_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/ButtonBlack"
        tools:text="Enviar"
        android:textSize="18sp"
        android:layout_marginTop="32dp"/>


</LinearLayout>